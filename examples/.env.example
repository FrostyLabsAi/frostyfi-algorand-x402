# Paying account on Algorand MainNet. It must be opted in to USDC (ASA 31566704)
# and hold enough USDC for the calls you make. It needs no ALGO: the GoPlausible
# facilitator pays the network fee.
#
# Set ONE of these. Never commit a real key.
ALGORAND_MNEMONIC="word1 word2 ... word25"
# AVM_PRIVATE_KEY=base64(32-byte seed || 32-byte public key)

# Optional
# ENDPOINT=https://x402.frostylabs.ai/asa-intel/a2a
